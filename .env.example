# Panel backend inside the docker network (direct, not through Traefik).
REMNAWAVE_URL=http://remnawave:3000
# Panel API token: Remnawave → API tokens. Scopes: users:*,
# internal-squads:read, nodes:read, bandwidth-stats:read,
# infra-billing:read (providers and payment dates from Infra Billing) — or *.
REMNAWAVE_TOKEN=
# Only if the panel sits behind caddy-with-auth (Auth Portal API key).
REMNAWAVE_API_KEY=

# Domain of the panel; the app is routed at https://$PANEL_DOMAIN/control/.
PANEL_DOMAIN=panel.example.com
# Host port the container is published on (frp remote_port = 1${HOST_PORT}).
HOST_PORT=8080
# URL prefix (compose sets /control). Empty = serve at the root.
BASE_PATH=

# Signs admin session cookies. Generate: openssl rand -hex 32
JWT_SECRET=
# Set to false only for plain-http local runs.
SECURE_COOKIE=true

# Admins log in with their panel credentials. This local login is a fallback
# for panels with password login disabled (OAuth/passkeys only); empty = off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: Remnawave webhooks for instant cache updates. The panel only
# accepts https://, so set its WEBHOOK_URL to the public route
# https://$PANEL_DOMAIN/control/api/webhooks/remnawave and use the same value
# as its WEBHOOK_SECRET_HEADER here (requests are HMAC-signed with it).
WEBHOOK_SECRET=

# subpage's addons.yml on the host (compose mounts it read-only).
ADDONS_FILE=../subpage/addons.yml
# Local (non-docker) path of the same file.
ADDONS_CONFIG=./addons.yml

DB_PATH=./data/vpn-control.db
PORT=8080
TZ=Europe/Moscow
SYNC_INTERVAL=10m
# How often node traffic for metered (per-GB) expenses is pulled.
TRAFFIC_SYNC_INTERVAL=1h
DEBUG=false
